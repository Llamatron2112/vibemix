#
# spec file for vibemix (openSUSE Tumbleweed / OBS)
#
# Source0 is the release source tarball (submodules included):
#   packaging/opensuse/make-source-tarball.sh
# Source1 is generated by the cargo_vendor service (see _service):
#   osc service manualrun   # or: osc service mr
#   osc add vendor.tar.zst
#
%define debug_package %{nil}

Name:           vibemix
Version:        1.0.2
Release:        0
Summary:        Modular LV2/VST3/CLAP audio mixer for JACK/PipeWire
License:        MIT OR Apache-2.0
Group:          Productivity/Multimedia/Sound/Editors and Convertors
URL:            https://github.com/Llamatron2112/vibemix
Source0:        vibemix-%{version}.tar.gz
Source1:        vendor.tar.zst

BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  zstd
BuildRequires:  hicolor-icon-theme
BuildRequires:  gcc-c++
BuildRequires:  cmake
BuildRequires:  ninja
BuildRequires:  pkgconf-pkg-config
BuildRequires:  lld
BuildRequires:  qt6-base-common-devel
BuildRequires:  qt6-core-devel
BuildRequires:  qt6-gui-devel
BuildRequires:  qt6-dbus-devel
BuildRequires:  qt6-network-devel
BuildRequires:  qt6-qml-devel
BuildRequires:  qt6-quick-devel
BuildRequires:  qt6-quickcontrols2-devel
BuildRequires:  qt6-quickdialogs2-devel
BuildRequires:  qt6-declarative-tools
BuildRequires:  qt6-declarative-imports
BuildRequires:  liblilv-0-devel
BuildRequires:  suil-devel
BuildRequires:  lv2-devel
BuildRequires:  pipewire-libjack-0_3-devel
BuildRequires:  libX11-devel
BuildRequires:  Mesa-libGL-devel
BuildRequires:  libglvnd-devel

# cxx-qt compiles the QML ahead-of-time, and its output uses Qt private API.
# OBS rebuilds this package when Tumbleweed's Qt changes, so the binary always
# matches the distro's Qt. The floor keeps older systems from installing it.
Requires:       libQt6Core6 >= 6.12
Requires:       libQt6Gui6 >= 6.12
Requires:       libQt6DBus6 >= 6.12
Requires:       libQt6Network6 >= 6.12
Requires:       libQt6Qml6 >= 6.12
Requires:       libQt6Quick6 >= 6.12
Requires:       qt6-declarative-imports
Requires:       liblilv-0-0
Requires:       libsuil-0-0
Requires:       suil-plugin-x11
Requires:       pipewire-libjack-0_3
Requires:       pipewire-jack
Requires:       hicolor-icon-theme
Recommends:     gtk3
Recommends:     suil-plugin-x11-in-gtk3

%description
vibemix is a modular audio mixer for JACK/PipeWire with LV2, VST3 and CLAP
plugin support. It is split into a real-time audio engine and a Qt Quick
control surface that talk over a small OSC control protocol.

Features include strips and buses with pre/post-fader insert chains, per-bus
sends, external aux returns, sidechain routing, native plugin editors, an
in-app JACK patchbay, MIDI clock sync and learnable MIDI/keyboard bindings.

%prep
%autosetup -a1

%build
export QMAKE=/usr/bin/qmake6
export PATH="/usr/libexec/qt6:%{_libexecdir}/qt6:$PATH"
export RUSTFLAGS="-C link-arg=-fuse-ld=lld"
cargo build --release --locked --offline --workspace

%install
install -Dm755 target/release/vibemix-engine %{buildroot}%{_bindir}/vibemix-engine
install -Dm755 target/release/vibemix-gui %{buildroot}%{_bindir}/vibemix-gui
install -Dm755 packaging/vibemix %{buildroot}%{_bindir}/vibemix
install -Dm644 packaging/vibemix.desktop \
    %{buildroot}%{_datadir}/applications/vibemix.desktop
install -Dm644 packaging/vibemix.svg \
    %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/vibemix.svg

%files
%license LICENSE-MIT LICENSE-APACHE
%{_bindir}/vibemix
%{_bindir}/vibemix-engine
%{_bindir}/vibemix-gui
%{_datadir}/applications/vibemix.desktop
%{_datadir}/icons/hicolor/scalable/apps/vibemix.svg
